{
  "name": "kubecontext-manager",
  "version": "0.3.0",
  "description": "Desktop, tray and CLI Kubernetes context manager",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "bin": {
    "kcm": "dist/cli.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs && vite build && npm run licenses",
    "licenses": "node scripts/licenses.mjs",
    "start": "electron .",
    "cli": "node dist/cli.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/smoke.mjs",
    "check": "tsc --noEmit",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never"
  },
  "build": {
    "appId": "dev.kubecontext.manager",
    "productName": "KubeContext",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/licenses/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "dist/licenses", "to": "licenses" }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "icon": "dist/icon.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "zip"
      ]
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "lucide-react": "^1.69.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
